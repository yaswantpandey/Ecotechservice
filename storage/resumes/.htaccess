# Resumes are private. Nothing in this tree may ever be served directly.
# They are streamed only by an authenticated controller.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: never hand anything here to an interpreter.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
AddType text/plain .php .phtml .phar
