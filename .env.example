; Ecotech Service production environment
; Replace the database and SMTP placeholders with your hosting credentials.

APP_ENV=production
APP_URL=https://ecotechservices.tech

DB_HOST=localhost
DB_NAME=ecotech_service
DB_USER=your_database_user
DB_PASS=your_database_password

; Generate a unique long random value for production.
CSRF_SECRET=8b7c2e1a4d6f9c0b3e5a7d1f8c2b6e4a9d0f3c7b1e5a8d2f6c9b4e7a1d5f8c

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-mailbox@ecotechservices.tech
SMTP_PASS=your-smtp-password
SMTP_FROM=your-mailbox@ecotechservices.tech
SMTP_FROM_NAME=Ecotech Service
SMTP_ENCRYPTION=ssl

; Digits only, including country code.
WHATSAPP_NUMBER=917398301184

; Search Engine Indexing & Bing Webmaster
BING_WEBMASTER_API_KEY=your-bing-api-key
INDEXNOW_KEY=your-indexnow-key
INDEXNOW_KEY_LOCATION=https://ecotechservices.tech/your-indexnow-key.txt
