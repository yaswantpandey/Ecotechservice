# Uploaded images are served as static files only.
# Never hand anything here to an interpreter, even if a script slips in.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .pht .phar
Options -ExecCGI -Indexes

<FilesMatch "\.(php|phtml|php\d|pht|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
