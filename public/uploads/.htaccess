# Uploaded images are served as static files only.
# Kept to directives shared hosts allow in .htaccess: `Options`, handler and
# php_flag overrides return HTTP 500 on hosts such as InfinityFree.
# Security::uploadImage() already forces image extensions; this is a backstop.
<FilesMatch "\.(php|phtml|php\d|pht|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
